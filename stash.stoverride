name: 自用 AI 与 X 远程分流规则
desc: GEOSITE 配合自定义补充；服务出口仅提供美国和新加坡，DeepSeek 默认直连。
author: zhazhayu01
homepage: https://github.com/zhazhayu01/stash-rules
icon: https://raw.githubusercontent.com/Hawaiine/Oasisic-Icons/main/icons/System/GeneralAI/GeneralAI.png

# 只有地区组从原配置读取节点，并按名称筛选；服务组仅引用这两个地区组。
proxy-groups:
  - name: RS-美国
    type: select
    icon: https://raw.githubusercontent.com/Hawaiine/Oasisic-Icons/main/icons/Country/US/US.png
    include-all: true
    filter: '(?i)(美国|美國|美西|美东|美東|洛杉矶|洛杉磯|圣何塞|聖何塞|西雅图|西雅圖|纽约|紐約|🇺🇸|United[ _-]*States|(?:^|[^a-z])USA?(?:[^a-z]|$))'
  - name: RS-新加坡
    type: select
    icon: https://raw.githubusercontent.com/Hawaiine/Oasisic-Icons/main/icons/Country/Singapore/Singapore.png
    include-all: true
    filter: '(?i)(新加坡|狮城|獅城|🇸🇬|Singapore|(?:^|[^a-z])SGP?(?:[^a-z]|$))'
  - name: RS-OpenAI
    type: select
    icon: https://raw.githubusercontent.com/Hawaiine/Oasisic-Icons/main/icons/AI/OpenAI/OpenAI.png
    proxies:
      - RS-美国
      - RS-新加坡
  - name: RS-Claude
    type: select
    icon: https://raw.githubusercontent.com/Hawaiine/Oasisic-Icons/main/icons/AI/Anthropic/Anthropic.png
    proxies:
      - RS-美国
      - RS-新加坡
  - name: RS-X
    type: select
    icon: https://raw.githubusercontent.com/Hawaiine/Oasisic-Icons/main/icons/SpaceXAI/X/X.png
    proxies:
      - RS-美国
      - RS-新加坡
  - name: RS-Gemini
    type: select
    icon: https://raw.githubusercontent.com/Hawaiine/Oasisic-Icons/main/icons/Google/GoogleAI/GoogleAI.png
    proxies:
      - RS-美国
      - RS-新加坡
  - name: RS-Grok
    type: select
    icon: https://raw.githubusercontent.com/Hawaiine/Oasisic-Icons/main/icons/SpaceXAI/xAI/Grok/Grok.png
    proxies:
      - RS-美国
      - RS-新加坡
  - name: RS-DeepSeek
    type: select
    icon: https://raw.githubusercontent.com/Hawaiine/Oasisic-Icons/main/icons/AI/DeepSeek/DeepSeek.png
    proxies:
      - DIRECT
      - RS-美国
      - RS-新加坡
  - name: RS-额外代理
    type: select
    icon: https://raw.githubusercontent.com/Hawaiine/Oasisic-Icons/main/icons/System/Proxy/Proxy.png
    proxies:
      - RS-美国
      - RS-新加坡

rule-providers:
  rs-openai:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/zhazhayu01/stash-rules/main/rules/openai.yaml
    path: ./ruleset/rs-openai.yaml
    interval: 86400
  rs-claude:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/zhazhayu01/stash-rules/main/rules/claude.yaml
    path: ./ruleset/rs-claude.yaml
    interval: 86400
  rs-x:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/zhazhayu01/stash-rules/main/rules/x.yaml
    path: ./ruleset/rs-x.yaml
    interval: 86400
  rs-gemini:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/zhazhayu01/stash-rules/main/rules/gemini.yaml
    path: ./ruleset/rs-gemini.yaml
    interval: 86400
  rs-grok:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/zhazhayu01/stash-rules/main/rules/grok.yaml
    path: ./ruleset/rs-grok.yaml
    interval: 86400
  rs-deepseek:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/zhazhayu01/stash-rules/main/rules/deepseek.yaml
    path: ./ruleset/rs-deepseek.yaml
    interval: 86400
  rs-extra-proxy:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/zhazhayu01/stash-rules/main/rules/extra-proxy.yaml
    path: ./ruleset/rs-extra-proxy.yaml
    interval: 86400
  rs-extra-direct:
    behavior: classical
    format: yaml
    url: https://raw.githubusercontent.com/zhazhayu01/stash-rules/main/rules/extra-direct.yaml
    path: ./ruleset/rs-extra-direct.yaml
    interval: 86400

# Stash 覆写默认将规则插到原配置规则之前。
# 先匹配自定义直连、额外代理和服务补充，再匹配社区分类。
rules:
  - RULE-SET,rs-extra-direct,DIRECT
  - RULE-SET,rs-extra-proxy,RS-额外代理
  - RULE-SET,rs-openai,RS-OpenAI
  - RULE-SET,rs-claude,RS-Claude
  - RULE-SET,rs-x,RS-X
  - RULE-SET,rs-gemini,RS-Gemini
  - RULE-SET,rs-grok,RS-Grok
  - RULE-SET,rs-deepseek,RS-DeepSeek
  - GEOSITE,openai,RS-OpenAI
  - GEOSITE,anthropic,RS-Claude
  - GEOSITE,google-deepmind,RS-Gemini
  # xai 包含 grok.x.com，需先于包含整个 x.com 的 twitter 分类。
  - GEOSITE,xai,RS-Grok
  - GEOSITE,deepseek,RS-DeepSeek
  - GEOSITE,twitter,RS-X
